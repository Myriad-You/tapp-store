{
  "id": "cn.astelysin.signature-board",
  "name": "共享签名板",
  "version": "0.4.0",
  "description": "让 Myriad 访客在共享画布上签名、涂鸦并浏览公开历史。",
  "author": { "name": "Astelysin" },
  "category": "social",
  "minSystemVersion": "0.3.36",
  "themeColor": "#8b5cf6",
  "permissions": [
    "storage:read",
    "storage:write",
    "ui:confirm",
    "widget:register",
    "federation:read",
    "federation:room",
    "federation:message"
  ],
  "core": {
    "entry": "main.js"
  },
  "page": {
    "entry": "page/entry.js",
    "template": "page.html",
    "styles": "page.css"
  },
  "widgets": [
    {
      "id": "board-preview",
      "name": "共享签名板",
      "description": "在主页展示最近发布的签名板快照。",
      "icon": "✍️",
      "category": "visualization",
      "defaultSize": "4x2",
      "sizes": ["2x2", "4x2"],
      "entry": "widget/entry.js",
      "templates": {
        "2x2": "templates/widget-2x2.html",
        "4x2": "templates/widget-4x2.html"
      },
      "styles": "widget.css",
      "refreshPolicy": {
        "mode": "event",
        "refreshOnVisible": true
      }
    }
  ],
  "locales": {
    "en-US": {
      "name": "Shared Signature Board",
      "description": "Leave a signature or drawing on a shared canvas"
    },
    "ja-JP": {
      "name": "共有サインボード",
      "description": "共有キャンバスにサインや絵を残す"
    }
  }
}
