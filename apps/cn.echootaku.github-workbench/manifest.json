{
  "id": "cn.echootaku.github-workbench",
  "name": "GitHub 工作台",
  "version": "0.1.2",
  "minSystemVersion": "0.3.23",
  "description": "集中查看待审 PR、分配给我的 Issue、失败 Actions 与仓库发布动态。",
  "locales": {
    "en-US": {
      "name": "GitHub Workbench",
      "description": "Review pull requests, assigned issues, failed Actions, and releases in one place."
    },
    "ja-JP": {
      "name": "GitHub ワークベンチ",
      "description": "レビュー待ちPR、担当Issue、失敗したActions、リリースをまとめて確認できます。"
    }
  },
  "category": "developer",
  "main": "main.js",
  "author": {
    "name": "EchoOtaku",
    "url": "https://echootaku.cn"
  },
  "homepage": "https://echootaku.cn",
  "repository": "https://github.com/Myriad-You/tapp-store",
  "permissions": [
    "network:fetch",
    "storage:read",
    "storage:write",
    "ui:notification",
    "ui:openUrl",
    "ui:theme",
    "widget:register"
  ],
  "iconSvg": "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M9 19c-4.2 1.3-4.2-2.2-6-2.7M15 21v-3.4c0-1 .1-1.4-.5-2 2.8-.3 5.7-1.4 5.7-6.2A4.8 4.8 0 0 0 19 6.1a4.5 4.5 0 0 0-.1-3.3s-1-.3-3.4 1.3a11.7 11.7 0 0 0-6.2 0C6.9 2.5 5.9 2.8 5.9 2.8a4.5 4.5 0 0 0-.1 3.3 4.8 4.8 0 0 0-1.2 3.3c0 4.8 2.9 5.9 5.7 6.2-.5.5-.6 1-.6 2V21' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'/></svg>",
  "themeColor": "#6E5EA8",
  "hasPage": true,
  "cssMode": "separated",
  "pageTemplate": "page.html",
  "pageStyles": "page.css",
  "widgetStyles": "widget.css",
  "credentials": [
    {
      "key": "githubToken",
      "label": "GitHub Personal Access Token",
      "description": "建议使用 fine-grained PAT，仅授予 Metadata、Pull requests、Issues、Actions、Contents 的只读权限。令牌由 Myriad 加密保存，Tapp 无法读取。",
      "placeholder": "github_pat_…"
    }
  ],
  "openUrls": [
    {
      "id": "github",
      "url": "https://github.com/",
      "match": "origin"
    },
    {
      "id": "token-settings",
      "url": "https://github.com/settings/personal-access-tokens/new",
      "match": "exact"
    }
  ],
  "widgets": [
    {
      "id": "github-workbench-overview",
      "name": "GitHub 工作台概览",
      "description": "查看待审 PR、Issue 与失败 Actions 数量。",
      "icon": "github",
      "category": "stats",
      "defaultSize": "4x2",
      "sizes": ["2x2", "4x2", "4x4"],
      "templates": {
        "2x2": "templates/widget-2x2.html",
        "4x2": "templates/widget-4x2.html",
        "4x4": "templates/widget-4x4.html"
      },
      "refreshPolicy": {
        "mode": "event",
        "refreshOnVisible": true
      }
    }
  ],
  "apis": {
    "viewer": {
      "type": "http",
      "method": "GET",
      "access": "manager",
      "endpoint": "https://api.github.com/user",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "credential": {
        "key": "githubToken",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    },
    "repositories": {
      "type": "http",
      "method": "GET",
      "access": "manager",
      "endpoint": "https://api.github.com/user/repos?affiliation=owner%2Ccollaborator%2Corganization_member&sort=pushed&per_page=50",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "credential": {
        "key": "githubToken",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    },
    "issueSearch": {
      "type": "http",
      "method": "GET",
      "access": "manager",
      "endpoint": "https://api.github.com/search/issues?q={{params.query}}&sort=updated&order=desc&per_page=30",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "credential": {
        "key": "githubToken",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    },
    "workflowFailures": {
      "type": "http",
      "method": "GET",
      "access": "manager",
      "endpoint": "https://api.github.com/repos/{{params.owner}}/{{params.repo}}/actions/runs?status=failure&per_page=20",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "credential": {
        "key": "githubToken",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    },
    "releases": {
      "type": "http",
      "method": "GET",
      "access": "manager",
      "endpoint": "https://api.github.com/repos/{{params.owner}}/{{params.repo}}/releases?per_page=10",
      "headers": {
        "Accept": "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "credential": {
        "key": "githubToken",
        "header": "Authorization",
        "prefix": "Bearer "
      }
    }
  }
}
