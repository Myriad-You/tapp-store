{
  "id":"cn.wyyzxzyg.minecraft-hub",
  "name":"Minecraft 服务器与 Wiki",
  "version":"1.0.9",
  "minSystemVersion":"0.3.36",
  "description":"面向玩家的 Java/基岩版服务器查询、最近记录与 Minecraft Wiki 搜索工具",
  "category":"game",
  "core":{"entry":"core.js"},
  "author":{"name":"我願一直向著陽光.℡","url":"https://github.com/zgzyh"},
  "permissions":["storage:read","storage:write","ui:notification","ui:theme","ui:openUrl","network:fetch","widget:register"],
  "settings":[
    {"key":"homeServers","label":"我的服务器","type":"input","description":"填写首页小组件展示的服务器，多个项目用逗号分隔；格式：java|地址 或 bedrock|地址。示例：java|play.example.com,bedrock|example.com:19132","placeholder":"java|play.example.com,bedrock|example.com:19132","defaultValue":""},
    {"key":"homeSwitchSeconds","label":"服务器轮播间隔（秒）","type":"number","defaultValue":8,"min":3,"max":300,"step":1},
    {"key":"homeRefreshSeconds","label":"状态检测间隔（秒）","type":"number","defaultValue":60,"min":15,"max":3600,"step":1}
  ],
  "iconSvg":"<svg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><path fill='currentColor' d='M3 5.5 12 2l9 3.5v13L12 22l-9-3.5v-13Zm9-1.35L6.1 6.45 12 8.8l5.9-2.35L12 4.15Zm-7 4v8.98l6 2.34v-8.98L5 8.15Zm8 11.32 6-2.34V8.15l-6 2.34v8.98Z'/></svg>",
  "themeColor":"#57a64e",
  "page":{"entry":"page/index.js","template":"page.html","styles":"page.css"},
  "openUrls":[{"id":"minecraft-wiki","url":"https://zh.minecraft.wiki/w/","match":"prefix"},{"id":"java-download","url":"https://www.minecraft.net/zh-hans/download/server","match":"exact"},{"id":"bedrock-server","url":"https://www.minecraft.net/zh-hans/download/server/bedrock","match":"exact"},{"id":"bedrock-creator","url":"https://learn.microsoft.com/zh-cn/minecraft/creator/","match":"prefix"},{"id":"bedrock-samples","url":"https://github.com/Mojang/bedrock-samples","match":"exact"},{"id":"papermc","url":"https://papermc.io/downloads/paper","match":"exact"},{"id":"fabric","url":"https://fabricmc.net/use/server/","match":"exact"},{"id":"modrinth","url":"https://modrinth.com/","match":"exact"},{"id":"curseforge","url":"https://www.curseforge.com/minecraft","match":"exact"}],
  "widgets":[{"id":"server-status","name":"Minecraft 服务器状态","description":"在首页循环展示多台服务器的在线状态、人数、版本与 MOTD","icon":"server","entry":"widget/index.js","styles":"widget.css","defaultSize":"4x2","sizes":["4x2"],"refreshPolicy":{"mode":"interval","intervalSeconds":300,"refreshOnVisible":true},"category":"utility","templates":{"4x2":"widget-4x2.html"}}],
  "apis":{
    "javaStatus":{"type":"http","access":"public","endpoint":"https://api.mcsrvstat.us/3/{{params.address}}","method":"GET","headers":{"User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":5,"description":"查询 Java 版服务器"},
    "bedrockStatus":{"type":"http","access":"public","endpoint":"https://api.mcsrvstat.us/bedrock/3/{{params.address}}","method":"GET","headers":{"User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":5,"description":"查询基岩版服务器"},
    "wikiSearch":{"type":"http","access":"public","endpoint":"https://zh.minecraft.wiki/api.php?action=query&generator=search&gsrsearch={{params.query}}&gsrlimit=10&prop=extracts&exintro=1&explaintext=1&exsentences=3&format=json&formatversion=2","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":300,"description":"搜索中文 Minecraft Wiki"},
    "javaReleaseVersions":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-versions/vanilla/release","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":3600,"description":"获取 Java 正式版版本列表"},
    "javaSnapshotVersions":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-versions/vanilla/snapshot","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":3600,"description":"获取 Java 快照版版本列表"},
    "javaReleaseInfo":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-version-info/vanilla/release/{{params.version}}","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":86400,"description":"获取 Java 正式版发布日期"},
    "javaSnapshotInfo":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-version-info/vanilla/snapshot/{{params.version}}","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":86400,"description":"获取 Java 快照版发布日期"},
    "bedrockLatestVersions":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-versions/bedrock/latest/windows","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":3600,"description":"获取基岩版正式版本列表"},
    "bedrockPreviewVersions":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-versions/bedrock/preview/windows","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":3600,"description":"获取基岩版预览版本列表"},
    "bedrockLatestInfo":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-version-info/bedrock/latest/windows/{{params.version}}","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":86400,"description":"获取基岩版正式版本详情"},
    "bedrockPreviewInfo":{"type":"http","access":"public","endpoint":"https://mcjarfiles.com/api/get-version-info/bedrock/preview/windows/{{params.version}}","method":"GET","headers":{"Accept":"application/json","User-Agent":"Myriad-Minecraft-Hub/1.0.8 (https://github.com/zgzyh/tapp-store)"},"cacheTtl":86400,"description":"获取基岩版预览版本详情"}
  }
}
