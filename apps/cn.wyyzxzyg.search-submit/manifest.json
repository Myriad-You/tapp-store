{
  "id": "cn.wyyzxzyg.search-submit",
  "name": "搜索引擎收录提交",
  "version": "1.0.1",
  "minSystemVersion": "0.3.27",
  "description": "仅管理员可用的百度主动推送与 IndexNow URL 提交工具",
  "category": "developer",
  "main": "main.js",
  "author": {
    "name": "我願一直向著陽光.℡",
    "url": "https://github.com/zgzyh"
  },
  "permissions": [
    "storage:read",
    "ui:notification",
    "ui:confirm",
    "ui:theme",
    "ui:openUrl",
    "network:fetch"
  ],
  "iconSvg": "<svg viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><circle cx='11' cy='11' r='6' stroke='currentColor' stroke-width='2'/><path d='m16 16 4 4M8 11h6M11 8v6' stroke='currentColor' stroke-width='2'/></svg>",
  "themeColor": "#2563eb",
  "hasPage": true,
  "cssMode": "separated",
  "pageStyles": "page.css",
  "pageTemplate": "page.html",
  "openUrls": [
    {"id":"baidu-token","url":"https://ziyuan.baidu.com/linksubmit/index","match":"exact"},
    {"id":"indexnow-key","url":"https://www.indexnow.org/faq","match":"exact"}
  ],
  "apis": {
    "baiduSubmit": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://data.zz.baidu.com/urls?site={{params.site}}&token={{params.token}}",
      "method": "POST",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      },
      "bodyMode": "raw",
      "body": "{{params.body}}",
      "description": "百度主动推送"
    },
    "indexNowSubmit": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api.indexnow.org/indexnow",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "host": "{{params.host}}",
        "key": "{{params.key}}",
        "urlList": "{{params.urls}}"
      },
      "description": "IndexNow 提交"
    },
    "indexNowSubmitWithLocation": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api.indexnow.org/indexnow",
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "host": "{{params.host}}",
        "key": "{{params.key}}",
        "keyLocation": "{{params.keyLocation}}",
        "urlList": "{{params.urls}}"
      },
      "description": "IndexNow 自定义密钥地址"
    }
  }
}
