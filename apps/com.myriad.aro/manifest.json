{
  "id": "com.myriad.aro",
  "name": "Aro",
  "version": "1.0.59",
  "description": "社交中心，统一管理消息、时间线、环网与个人资料",
  "locales": {
    "en-US": {
      "description": "Social hub for messages, timeline, ring network and profile in one place"
    },
    "ja-JP": {
      "description": "メッセージ・タイムライン・リングネット・プロフィールをまとめるソーシャルハブ"
    }
  },
  "author": {
    "name": "Myriad Team",
    "url": "https://github.com/Myriad-You"
  },
  "permissions": [
    "storage:read",
    "storage:write",
    "ui:notification",
    "ui:theme",
    "federation:read",
    "federation:write",
    "federation:message",
    "federation:files",
    "platform:read",
    "report:read",
    "tappList:read",
    "tappList:manage",
    "brew:read",
    "media:control",
    "media:read",
    "network:fetch"
  ],
  "iconSvg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M2 12h20\"/><path d=\"M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z\"/></svg>",
  "themeColor": "#6366f1",
  "minSystemVersion": "0.2.1",
  "backgroundRequirements": [
    "notification"
  ],
  "settings": [
    {
      "key": "pollInterval",
      "label": "轮询间隔 (秒)",
      "type": "number",
      "defaultValue": 15,
      "min": 5,
      "max": 120,
      "step": 5
    },
    {
      "key": "notifyOnMessage",
      "label": "新消息通知",
      "type": "toggle",
      "defaultValue": true
    }
  ],
  "category": "social",
  "core": {
    "entry": "index.js",
    "styles": "styles.css"
  },
  "page": {
    "template": "page.html",
    "styles": "page.css",
    "entry": "page/entry.js"
  }
}
