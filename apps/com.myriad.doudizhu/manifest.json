{
  "id": "com.myriad.doudizhu",
  "name": "斗地主",
  "version": "1.0.0",
  "minSystemVersion": "0.3.0",
  "description": "三人单机斗地主：经典牌桌与若泉绮羽㥹銯麏主题、完整规则、智能提示与本地 AI",
  "locales": {
    "en-US": { "name": "Fight the Landlord", "description": "Offline Dou Dizhu with local AI, a classic table, and the 若泉绮羽㥹銯麏 theme" },
    "ja-JP": { "name": "闘地主", "description": "クラシック卓と若泉绮羽㥹銯麏テーマを切り替えられる完全オフライン闘地主" }
  },
  "category": "game",
  "main": "main.js",
  "author": { "name": "Myriad Team", "url": "https://github.com/Myriad-You" },
  "permissions": ["storage:read", "storage:write", "ui:fullscreen", "widget:register"],
  "iconSvg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"4\" y=\"3\" width=\"11\" height=\"16\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"9\" y=\"5\" width=\"11\" height=\"16\" rx=\"2\" fill=\"currentColor\" fill-opacity=\".12\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M14.5 10.2c-1.8 0-3 1.7-3 3.1 0 2.2 3 4.5 3 4.5s3-2.3 3-4.5c0-1.4-1.2-3.1-3-3.1Z\" fill=\"currentColor\"/></svg>",
  "themeColor": "#08745b",
  "hasPage": true,
  "cssMode": "separated",
  "widgetStyles": "widget.css",
  "pageStyles": "page.css",
  "pageTemplate": "page.html",
  "pageModules": ["i18n.js", "cards.js", "rules.js", "ai.js", "engine.js", "storage.js", "audio.js", "theme.js", "render.js", "index.js"],
  "assets": [
    "assets/widget/landlord-win.png",
    "assets/widget/farmer-loss.png",
    "assets/theme/iroha/a.webp",
    "assets/theme/iroha/2.webp",
    "assets/theme/iroha/3.webp",
    "assets/theme/iroha/4.webp",
    "assets/theme/iroha/5.webp",
    "assets/theme/iroha/6.webp",
    "assets/theme/iroha/7.webp",
    "assets/theme/iroha/8.webp",
    "assets/theme/iroha/9.webp",
    "assets/theme/iroha/10.webp",
    "assets/theme/iroha/j.webp",
    "assets/theme/iroha/q.webp",
    "assets/theme/iroha/k.webp",
    "assets/theme/iroha/small-joker.webp",
    "assets/theme/iroha/big-joker.webp",
    "assets/theme/iroha/card-back.webp"
  ],
  "widgets": [
    {
      "id": "daily-record",
      "name": "今日斗地主",
      "description": "展示今日胜负、净积分与最近一局结果",
      "icon": "spade",
      "category": "stats",
      "defaultSize": "2x2",
      "sizes": ["1x1", "2x2", "4x2"],
      "templates": {
        "1x1": "templates/widget-1x1.html",
        "2x2": "templates/widget-2x2.html",
        "4x2": "templates/widget-4x2.html"
      },
      "refreshPolicy": { "mode": "event", "refreshOnVisible": true }
    }
  ]
}
