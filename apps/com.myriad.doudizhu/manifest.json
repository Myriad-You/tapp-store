{
  "id": "com.myriad.doudizhu",
  "name": "斗地主",
  "version": "1.0.1",
  "minSystemVersion": "0.3.0",
  "description": "3 人斗地主：逐火十三英桀三语卡面、计时结算、可选 AI 单机与联邦联机",
  "locales": {
    "en-US": {
      "name": "Fight the Landlord",
      "description": "3-player Dou Dizhu with federation rooms and realtime multiplayer"
    },
    "ja-JP": {
      "name": "闘地主",
      "description": "3人制の闘地主。連邦ルームで招待してリアルタイム対戦"
    }
  },
  "category": "game",
  "main": "main.js",
  "author": {
    "name": "Myriad Team",
    "url": "https://github.com/Myriad-You"
  },
  "permissions": [
    "storage",
    "ai:chat",
    "federation:read",
    "federation:write",
    "federation:message"
  ],
  "settings": [
    {
      "key": "aiOpponentEnabled",
      "type": "toggle",
      "label": "启用 AI 对手",
      "description": "单机练习中允许机器人调用 Myriad 管理员配置的 AI；不可用时自动回退本地策略。",
      "defaultValue": false
    }
  ],
  "ai": {
    "protocolVersion": 2,
    "operations": [
      "chat"
    ],
    "modelTier": "standard",
    "outputFormats": [
      "text",
      "json"
    ]
  },
  "iconSvg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"3\" y=\"4\" width=\"12\" height=\"16\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"2\"/><rect x=\"9\" y=\"4\" width=\"12\" height=\"16\" rx=\"1.5\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M12 10h2M12 14h3\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>",
  "themeColor": "#ef4444",
  "hasPage": true,
  "cssMode": "separated",
  "pageStyles": "page.css",
  "pageTemplate": "page.html",
  "assets": [
