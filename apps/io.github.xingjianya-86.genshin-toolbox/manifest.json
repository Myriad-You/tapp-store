{
  "id": "io.github.xingjianya-86.genshin-toolbox",
  "name": "应急食品",
  "version": "1.6.5",
  "description": "米游社扫码绑定后展示原神账号资料、树脂委托、角色简表、深境螺旋与幻想真境剧诗战绩，并提供 2x2 / 4x2 / 4x4 桌面小组件",
  "locales": {
    "en-US": {
      "name": "Emergency Food",
      "description": "Bind your miHoYo account by QR login to show Genshin profile, resin & commissions, characters, Spiral Abyss and Imaginarium Theater records, with 2x2 / 4x2 / 4x4 dashboard widgets"
    },
    "ja-JP": {
      "name": "緊急食料",
      "description": "miHoYo アカウントを QR ログインで連携し、原神のプロフィール・樹脂・キャラ・深境螺旋・幻想真境劇詩の記録を表示。2x2 / 4x2 / 4x4 ウィジェット対応"
    }
  },
  "category": "game",
  "author": {
    "name": "xingjianya-86",
    "url": "https://github.com/xingjianya-86"
  },
  "permissions": [
    "network:fetch",
    "storage:read",
    "storage:write",
    "ui:notification",
    "ui:confirm",
    "ui:theme",
    "ui:openUrl",
    "widget:register",
    "scheduler:register"
  ],
  "backgroundRequirements": ["scheduler", "sync"],
  "openUrls": [
    {
      "id": "obc-character",
      "url": "https://baike.mihoyo.com/ys/obc/content/",
      "match": "prefix"
    }
  ],
  "iconSvg": "<svg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'><rect width='24' height='24' rx='7' fill='#3b4a6b'/><path d='M12 3.6l2.2 4.9 5.3.6-4 3.6 1.1 5.3L12 15.4l-4.6 2.6 1.1-5.3-4-3.6 5.3-.6z' fill='#ffe08a' stroke='#ffd166' stroke-width='0.8' stroke-linejoin='round'/><circle cx='12' cy='12.4' r='2.1' fill='#3b4a6b'/></svg>",
  "themeColor": "#ffd166",
  "core": {
    "entry": "core.js",
    "styles": "styles.css"
  },
  "page": {
    "entry": "page/index.js",
    "template": "page.html",
    "styles": "page.css"
  },
  "widgets": [
    {
      "id": "genshin",
      "name": "原神面板",
      "description": "头像、树脂、每日委托与角色简表",
      "icon": "🌟",
      "entry": "widget/index.js",
      "styles": "widget.css",
      "defaultSize": "2x2",
      "sizes": ["2x2", "4x2", "4x4"],
      "category": "game",
      "refreshPolicy": {
        "mode": "event",
        "refreshOnVisible": false
      },
      "templates": {
        "2x2": "widget-genshin-2x2.html",
        "4x2": "widget-genshin-4x2.html",
        "4x4": "widget-genshin-4x4.html"
      }
    },
    {
      "id": "abyss",
      "name": "深渊战绩",
      "description": "深境螺旋与幻想真境剧诗通关概览",
      "icon": "⚔️",
      "entry": "widget/index.js",
      "styles": "widget.css",
      "defaultSize": "2x2",
      "sizes": ["2x2", "4x2", "4x4"],
      "category": "game",
      "refreshPolicy": {
        "mode": "event",
        "refreshOnVisible": false
      },
      "templates": {
        "2x2": "widget-abyss-2x2.html",
        "4x2": "widget-abyss-4x2.html",
        "4x4": "widget-abyss-4x4.html"
      }
    }
  ],
  "apis": {
    "dailyNote": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api-takumi-record.mihoyo.com/game_record/app/genshin/api/dailyNote?role_id={{params.role_id}}&server={{params.server}}",
      "method": "GET",
      "headers": {
        "DS": "{{params.ds}}",
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com",
        "Cookie": "{{params.cookie}}",
        "x-rpc-device_id": "{{params.device_id}}",
        "x-rpc-device_fp": "{{params.device_fp}}"
      },
      "description": "每日委托与树脂"
    },
    "playerIndex": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api-takumi-record.mihoyo.com/game_record/app/genshin/api/index?role_id={{params.role_id}}&server={{params.server}}",
      "method": "GET",
      "headers": {
        "DS": "{{params.ds}}",
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com",
        "Cookie": "{{params.cookie}}",
        "x-rpc-device_id": "{{params.device_id}}",
        "x-rpc-device_fp": "{{params.device_fp}}"
      },
      "description": "玩家资料与角色简表"
    },
    "bbsUser": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://bbs-api.miyoushe.com/user/wapi/getUserFullInfo?uid={{params.uid}}&gids=2",
      "method": "GET",
      "headers": {
        "DS": "{{params.ds}}",
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com",
        "Cookie": "{{params.cookie}}",
        "x-rpc-device_id": "{{params.device_id}}",
        "x-rpc-device_fp": "{{params.device_fp}}"
      },
      "description": "米游社账号资料"
    },
    "spiralAbyss": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api-takumi-record.mihoyo.com/game_record/app/genshin/api/spiralAbyss?role_id={{params.role_id}}&schedule_type={{params.schedule_type}}&server={{params.server}}",
      "method": "GET",
      "headers": {
        "DS": "{{params.ds}}",
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com",
        "Cookie": "{{params.cookie}}",
        "x-rpc-device_id": "{{params.device_id}}",
        "x-rpc-device_fp": "{{params.device_fp}}"
      },
      "description": "深境螺旋战绩"
    },
    "poetryAbyss": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api-takumi-record.mihoyo.com/game_record/app/genshin/api/role_combat?server={{params.server}}&role_id={{params.role_id}}&need_detail=true",
      "method": "GET",
      "headers": {
        "DS": "{{params.ds}}",
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com",
        "Cookie": "{{params.cookie}}",
        "x-rpc-device_id": "{{params.device_id}}",
        "x-rpc-device_fp": "{{params.device_fp}}"
      },
      "description": "幻想真境剧诗战绩"
    },
    "hypQrCreate": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://passport-api.mihoyo.com/account/ma-cn-passport/app/createQRLogin",
      "method": "POST",
      "headers": {
        "x-rpc-app_id": "ddxf5dufpuyo",
        "x-rpc-client_type": "3",
        "x-rpc-device_id": "{{params.device_id}}",
        "User-Agent": "HYPContainer/1.3.3.182"
      },
      "body": {},
      "description": "创建 HYP 扫码登录"
    },
    "hypQrCheck": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://passport-api.mihoyo.com/account/ma-cn-passport/app/queryQRLoginStatus",
      "method": "POST",
      "headers": {
        "x-rpc-app_id": "ddxf5dufpuyo",
        "x-rpc-client_type": "3",
        "x-rpc-device_id": "{{params.device_id}}",
        "User-Agent": "HYPContainer/1.3.3.182"
      },
      "body": {
        "ticket": "{{params.ticket}}"
      },
      "description": "查询 HYP 扫码状态"
    },
    "getLTokenBySToken": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://api-takumi.mihoyo.com/account/auth/api/getLTokenBySToken?stoken={{params.stoken}}&uid={{params.uid}}&mid={{params.mid}}",
      "method": "GET",
      "headers": {
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "x-rpc-app_id": "bll8iq97cem8",
        "x-rpc-verify_key": "bll8iq97cem8",
        "Referer": "https://app.mihoyo.com",
        "Origin": "https://app.mihoyo.com",
        "DS": "{{params.ds}}",
        "Cookie": "mid={{params.mid}};stoken={{params.stoken}}"
      },
      "description": "stoken 换 ltoken（兜底）"
    },
    "stokenToCookie": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://passport-api.mihoyo.com/account/auth/api/getCookieAccountInfoBySToken?stoken={{params.stoken}}&uid={{params.uid}}&mid={{params.mid}}",
      "method": "GET",
      "headers": {
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com",
        "Cookie": "stuid={{params.uid}};stoken={{params.stoken}};mid={{params.mid}}"
      },
      "description": "stoken 换 cookie_token"
    },
    "obcSearch": {
      "type": "http",
      "access": "public",
      "endpoint": "https://api-static.mihoyo.com/common/blackboard/ys_obc/v1/search/content?app_sn=ys_obc&keyword={{params.keyword}}&page=1&size=5",
      "method": "GET",
      "headers": {
        "Referer": "https://baike.mihoyo.com/",
        "Origin": "https://baike.mihoyo.com",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
      },
      "description": "观测枢角色词条搜索"
    },
    "deviceFp": {
      "type": "http",
      "access": "manager",
      "endpoint": "https://public-data-api.mihoyo.com/device-fp/api/getFp",
      "method": "POST",
      "headers": {
        "x-rpc-app_version": "2.102.1",
        "x-rpc-client_type": "5",
        "X-Requested-With": "com.mihoyo.hyperion",
        "User-Agent": "Mozilla/5.0 (Linux; Android 13; PHK110 Build/SKQ1.221119.001; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/126.0.6478.133 Mobile Safari/537.36 miHoYoBBS/2.102.1",
        "Referer": "https://webstatic.mihoyo.com/",
        "Origin": "https://webstatic.mihoyo.com"
      },
      "body": {
        "device_id": "{{params.device_id}}",
        "seed_id": "{{params.seed_id}}",
        "platform": "2",
        "seed_time": "{{params.seed_time}}",
        "ext_fields": "{{params.ext_fields}}",
        "app_name": "bbs_cn",
        "bbs_device_id": "{{params.bbs_device_id}}",
        "device_fp": "{{params.device_fp}}"
      },
      "description": "生成设备指纹"
    }
  }
}
